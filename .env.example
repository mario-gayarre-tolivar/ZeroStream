# ZeroStream — Plantilla de Variables de Entorno (Arquitectura Zero-Storage)

# 1. Clave de desarrollador de TMDB (Gratuita para uso no comercial)
# Obtén tu clave en: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY=tu_clave_de_api_tmdb_aqui

# 2. URL de producción del proyecto (usada para OpenGraph, redes sociales y canonicals)
NEXT_PUBLIC_SITE_URL=https://zerostream.vercel.app

# 3. URL base de CDN para carátulas de TMDB (Opcional, por defecto CDN pública oficial)
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/
